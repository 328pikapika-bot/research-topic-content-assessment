{
  "name": "content-assessment-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "dev": "vite",
    "dev:nstl": "vite --mode nstl-local --host 0.0.0.0 --port 18093",
    "dev:nstl:17607": "powershell -NoProfile -Command \"$env:VITE_PROXY_BACKEND='http://127.0.0.1:17607'; npm run dev:nstl\"",
    "proxy:nstl-www": "node ./scripts/nstl-www-https-proxy.mjs",
    "dev:nstl:www": "powershell -ExecutionPolicy Bypass -File ./scripts/start-nstl-local.ps1",
    "dev:local-login": "npm run setup:nstl-local && npm run dev:nstl:www",
    "setup:nstl-local": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-nstl-local-dev.ps1",
    "build": "vite build",
    "security:render-sinks": "node ./scripts/check-render-sinks.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "pdfjs-dist": "4.8.69",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vue-tsc": "2.2.12"
  }
}
